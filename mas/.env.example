AGENT_EXECUTION_MODE=deterministic

# Optional LLM-assisted mode
LLM_PROVIDER=sumopod
LLM_BASE_URL=https://api.sumopod.com/v1
LLM_MODEL=
LLM_API_KEY=

# Security notes:
# - Do not commit .env.local.
# - Keep API keys server-side only.
# - Do not use NEXT_PUBLIC_ for secrets.
# - Deterministic mode works without API key.

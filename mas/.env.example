AGENT_EXECUTION_MODE=deterministic
LLM_PROVIDER=sumopod

# Generic optional LLM config
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Sumopod
SUMOPOD_BASE_URL=
SUMOPOD_MODEL=
SUMOPOD_API_KEY=

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=

# Security notes:
# - Do not commit .env.local.
# - Do not use NEXT_PUBLIC_ for secrets.
# - Deterministic mode works without API key.
# - One API key can power selected agent roles.
# - Separate API keys per agent are not required.
